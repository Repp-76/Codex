# Codex configuration
# Copy this file to .env and fill in only the provider(s) you plan to use.

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Owner/developer -- receives "new user linked" notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPER_ADMIN_ID=

# The linked user -- receives generated files, zipped projects, and
# conversation exports. Filled in automatically the first time you enter
# your Telegram ID at startup; set it here to skip that prompt.
# TELEGRAM_CHAT_ID is accepted as a fallback name for the same value.
TELEGRAM_USER_ID=

# Auto-delivery behavior. All three accept true/false.
TELEGRAM_AUTO_SEND_FILES=true
TELEGRAM_AUTO_SEND_PROJECTS=true
TELEGRAM_AUTO_SEND_CHAT=false

DEFAULT_PROVIDER=openai
DEFAULT_MODEL=
